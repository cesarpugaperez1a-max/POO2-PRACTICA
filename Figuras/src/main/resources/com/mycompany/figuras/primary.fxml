<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.figuras.PrimaryController">
   <children>
      <Label text="Contar número de clics" />
      <TextField fx:id="txtClicks" maxWidth="200"/>
      <Button fx:id="btnContar" text="¡Contar!" onAction="#contarClic" />
      
      <Label text="Esperar 10 segundos" />
      <ProgressBar fx:id="progressBar" progress="0.0" />
      <Button fx:id="btnEsperar" text="¡Esperar!" onAction="#iniciarEspera" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
